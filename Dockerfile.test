# Dockerfile for testing the dotfiles setup scripts across distributions.
#
# The standard stages run the setup.sh 'persistent' steps one script per layer
# (for build caching), in the same order as setup.sh. Not covered here:
#   - install_ghidra.sh / install_joern.sh: multi-GB downloads, run manually.
#   - install_trivy.sh: needs a running Docker daemon, unavailable during build.
#   - install_docker.sh service start / harden_ssh.sh restart: no systemd.

# --- Ubuntu ---
FROM ubuntu:22.04 AS ubuntu-test
ARG DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y sudo curl gpg wget && rm -rf /var/lib/apt/lists/*
RUN useradd -m -G sudo -s /bin/bash tester
RUN echo "tester ALL=(ALL) NOPASSWD: ALL" > /etc/sudoers.d/tester
WORKDIR /home/tester/dotfiles
COPY scripts/lib.sh ./scripts/lib.sh

# Phase 1: system-level scripts run as root
COPY scripts/install_base_deps.sh ./scripts/
RUN ./scripts/install_base_deps.sh
COPY scripts/install_docker.sh ./scripts/
RUN ./scripts/install_docker.sh && usermod -aG docker tester
COPY scripts/install_nerd_font.sh ./scripts/
RUN ./scripts/install_nerd_font.sh

# Phase 2: user environment
USER tester
ENV PATH="/home/tester/.local/bin:${PATH}"
COPY --chown=tester:tester scripts/install_terminal_tools.sh ./scripts/
RUN ./scripts/install_terminal_tools.sh
COPY --chown=tester:tester zsh ./zsh
COPY --chown=tester:tester tmux ./tmux
COPY --chown=tester:tester eza ./eza
COPY --chown=tester:tester git ./git
COPY --chown=tester:tester vivid ./vivid
COPY --chown=tester:tester nvim ./nvim
COPY --chown=tester:tester scripts/stow_dotfiles.sh ./scripts/
RUN ./scripts/stow_dotfiles.sh && [ -L /home/tester/.zshrc ] && [ -L /home/tester/.gitconfig ]
COPY --chown=tester:tester scripts/sync_nvim.sh ./scripts/
RUN ./scripts/sync_nvim.sh

# Phase 3: default tools (minus Ghidra/Joern/Trivy, see header)
COPY --chown=tester:tester scripts/install_jadx.sh scripts/install_apktool.sh scripts/install_dependency_check.sh ./scripts/
RUN ./scripts/install_jadx.sh && ./scripts/install_apktool.sh && ./scripts/install_dependency_check.sh
COPY --chown=tester:tester scripts/install_rev_pipx_tools.sh ./scripts/
RUN ./scripts/install_rev_pipx_tools.sh

# Phase 4: pwn profile
COPY --chown=tester:tester scripts/install_bloodhound.sh ./scripts/
RUN sudo ./scripts/install_bloodhound.sh
COPY --chown=tester:tester scripts/install_netexec.sh scripts/install_powerview.sh scripts/install_certipy.sh ./scripts/
RUN ./scripts/install_netexec.sh && ./scripts/install_powerview.sh && ./scripts/install_certipy.sh

# Phase 5: ssh profile (refuses to run without an authorized_keys file)
COPY --chown=tester:tester scripts/harden_ssh.sh ./scripts/
RUN mkdir -p -m 700 /home/tester/.ssh && echo "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIDummyKeyForTestsOnly tester" > /home/tester/.ssh/authorized_keys
RUN sudo ./scripts/harden_ssh.sh && grep -qx "PasswordAuthentication no" /etc/ssh/sshd_config

# Idempotency: a second run must not reinstall or fail
RUN ./scripts/install_terminal_tools.sh | grep "nvim .* is already installed" \
    && ./scripts/install_jadx.sh | grep "already installed" \
    && ./scripts/install_certipy.sh | grep "already installed" \
    && sudo ./scripts/harden_ssh.sh

# --- Kali Linux ---
FROM kalilinux/kali-rolling AS kali-test
ARG DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y sudo curl gpg wget && rm -rf /var/lib/apt/lists/*
RUN useradd -m -G sudo -s /bin/bash tester
RUN echo "tester ALL=(ALL) NOPASSWD: ALL" > /etc/sudoers.d/tester
WORKDIR /home/tester/dotfiles
COPY scripts/lib.sh ./scripts/lib.sh

# Phase 1: system-level scripts run as root
COPY scripts/install_base_deps.sh ./scripts/
RUN ./scripts/install_base_deps.sh
COPY scripts/install_docker.sh ./scripts/
RUN ./scripts/install_docker.sh && usermod -aG docker tester
COPY scripts/install_nerd_font.sh ./scripts/
RUN ./scripts/install_nerd_font.sh

# Phase 2: user environment
USER tester
ENV PATH="/home/tester/.local/bin:${PATH}"
COPY --chown=tester:tester scripts/install_terminal_tools.sh ./scripts/
RUN ./scripts/install_terminal_tools.sh
COPY --chown=tester:tester zsh ./zsh
COPY --chown=tester:tester tmux ./tmux
COPY --chown=tester:tester eza ./eza
COPY --chown=tester:tester git ./git
COPY --chown=tester:tester vivid ./vivid
COPY --chown=tester:tester nvim ./nvim
COPY --chown=tester:tester scripts/stow_dotfiles.sh ./scripts/
RUN ./scripts/stow_dotfiles.sh && [ -L /home/tester/.zshrc ] && [ -L /home/tester/.gitconfig ]
COPY --chown=tester:tester scripts/sync_nvim.sh ./scripts/
RUN ./scripts/sync_nvim.sh

# Phase 3: default tools (minus Ghidra/Joern/Trivy, see header)
COPY --chown=tester:tester scripts/install_jadx.sh scripts/install_apktool.sh scripts/install_dependency_check.sh ./scripts/
RUN ./scripts/install_jadx.sh && ./scripts/install_apktool.sh && ./scripts/install_dependency_check.sh
COPY --chown=tester:tester scripts/install_rev_pipx_tools.sh ./scripts/
RUN ./scripts/install_rev_pipx_tools.sh

# Phase 4: pwn profile
COPY --chown=tester:tester scripts/install_bloodhound.sh ./scripts/
RUN sudo ./scripts/install_bloodhound.sh
COPY --chown=tester:tester scripts/install_netexec.sh scripts/install_powerview.sh scripts/install_certipy.sh ./scripts/
RUN ./scripts/install_netexec.sh && ./scripts/install_powerview.sh && ./scripts/install_certipy.sh

# Phase 5: ssh profile (refuses to run without an authorized_keys file)
COPY --chown=tester:tester scripts/harden_ssh.sh ./scripts/
RUN mkdir -p -m 700 /home/tester/.ssh && echo "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIDummyKeyForTestsOnly tester" > /home/tester/.ssh/authorized_keys
RUN sudo ./scripts/harden_ssh.sh && grep -qx "PasswordAuthentication no" /etc/ssh/sshd_config

# Idempotency: a second run must not reinstall or fail
RUN ./scripts/install_terminal_tools.sh | grep "nvim .* is already installed" \
    && ./scripts/install_jadx.sh | grep "already installed" \
    && ./scripts/install_certipy.sh | grep "already installed" \
    && sudo ./scripts/harden_ssh.sh

# --- Kali Linux Guest (Sandbox) Test ---
# The tester user has no sudo at all: guest mode must work without it.
FROM kalilinux/kali-rolling AS kali-guest-test
ARG DEBIAN_FRONTEND=noninteractive
# Host prerequisites that guest mode expects the host admin to provide.
RUN apt-get update && apt-get install -y \
        ca-certificates curl tar xz-utils unzip git zsh tmux build-essential cmake \
    && rm -rf /var/lib/apt/lists/*
RUN useradd -m -s /bin/bash tester
USER tester
WORKDIR /home/tester/dotfiles
COPY --chown=tester:tester . .
RUN ./setup.sh guest
# Isolation: nothing written to $HOME outside the repo
RUN [ ! -e /home/tester/.zshrc ] && [ ! -e /home/tester/.tmux.conf ] \
    && [ ! -e /home/tester/.local ] && [ ! -e /home/tester/.config ]
# Everything lives in the gitignored sandbox
RUN [ -x /home/tester/dotfiles/.guest/local/bin/nvim ] \
    && [ -d /home/tester/dotfiles/.guest/data/nvim/lazy/lazy.nvim ]
# activate.sh works from bash and zsh, independent of the current directory
RUN cd /tmp && bash -c "source /home/tester/dotfiles/activate.sh && [ \"\$ZDOTDIR\" = /home/tester/dotfiles/zsh ]"
RUN cd /tmp && zsh -c "source /home/tester/dotfiles/activate.sh && [[ \$ZDOTDIR == /home/tester/dotfiles/zsh ]]"
# The interactive shell picks up the repo's completions and keeps history in the sandbox
RUN bash -c "source ./activate.sh && zsh -ic '[[ \$fpath == */home/tester/dotfiles/zsh/.zsh_completions* && \$HISTFILE == /home/tester/dotfiles/.guest/* ]]'"
